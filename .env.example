# =============================================================================
# Frontend (Vite) — these are PUBLIC values and end up in the browser bundle.
# Copy to .env.local and fill in. Never put secret keys here.
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon (legacy) or publishable (sb_publishable_…) key from Project Settings → API
VITE_SUPABASE_ANON_KEY=
# Public site URL used for canonical/OpenGraph links (optional; defaults to window.location.origin)
VITE_SITE_URL=http://localhost:5173

# Firebase — phone OTP only. These are public values (a Firebase web config
# ships in every client bundle); the project is protected by its Authorized
# domains list, security rules and App Check, not by hiding these.
# Firebase console → Project settings → General → Your apps → SDK setup.
# Enable Phone under Authentication → Sign-in method, and add both
# localhost and your production domain under Authentication → Settings →
# Authorized domains, or verification fails with auth/unauthorized-domain.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Note: there is deliberately no Razorpay key here. The `create-payment` Edge
# Function returns the key id with each order, so rotating keys never requires
# a frontend rebuild.

# =============================================================================
# Supabase Edge Function secrets — DO NOT put these in .env.local.
# Set them with:  supabase secrets set --env-file ./supabase/.env   (see README)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase platform.
# =============================================================================
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAYX_ACCOUNT_NUMBER=        # optional, enables automated payouts via RazorpayX
# SITE_URL=https://your-domain.com  # used for links in emails + CORS allow-list
# ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173
# EMAIL_PROVIDER=console            # console | resend
# EMAIL_FROM="Spotlit <hello@your-domain.com>"
# RESEND_API_KEY=                   # required when EMAIL_PROVIDER=resend
# NOTIFICATION_WEBHOOK_SECRET=      # shared secret for the notifications → email webhook
# AI_API_KEY=                       # future: AI-powered smart search (kept server-side)
