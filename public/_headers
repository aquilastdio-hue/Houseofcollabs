# Netlify headers. Duplicated from netlify.toml so a drag-and-drop deploy of
# dist/ keeps caching and security headers.

# Vite emits content-hashed filenames — safe to cache permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/demo/*
  Cache-Control: public, max-age=604800

# Never cache the shell, or users keep a stale bundle after a deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), geolocation=(), microphone=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
